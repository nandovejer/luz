# LUZ Design System — Code Owners

# Default owner for all files in the repository
* @nandovejer

# CI/CD and GitHub configuration
.github/workflows/      @nandovejer
.github/                @nandovejer

# Design tokens (base layer)
packages/tokens/        @nandovejer
scripts/build-tokens.js @nandovejer

# Core design system (builds on tokens)
packages/core/          @nandovejer
scripts/build-core.js   @nandovejer
# A language file runs on every page that declares its language: reviewed on its own line
packages/core/src/i18n* @nandovejer

# Catalog layer (builds on core)
packages/catalog/      @nandovejer
scripts/build-catalog.js @nandovejer

# Packages for one kind of site (build on catalog; own version)
packages/landing/        @nandovejer
scripts/build-landing.js @nandovejer
packages/cms/            @nandovejer
scripts/build-cms.js     @nandovejer
packages/app/            @nandovejer
scripts/build-app.js     @nandovejer
packages/docs/           @nandovejer
scripts/build-docs.js    @nandovejer
scripts/build-package.js @nandovejer

# Dev tools (published, no CSS; own version, out of the fixed group)
packages/check/          @nandovejer
scripts/build-check.js   @nandovejer

# Build and configuration
scripts/                @nandovejer
package.json            @nandovejer
pnpm-workspace.yaml     @nandovejer

# Documentation
*.md                    @nandovejer
docs/                   @nandovejer
apps/docs/              @nandovejer
# The docs site generator writes every published page, its CSP and its links
scripts/docs-site/      @nandovejer
apps/docs/_layouts/     @nandovejer
apps/docs/_partials/    @nandovejer
apps/site/              @nandovejer
apps/landing/           @nandovejer

# Linting and testing configuration
eslint.config.js        @nandovejer
stylelint.config.js     @nandovejer
vitest.config.js        @nandovejer
playwright.config.js    @nandovejer

# The prompt-injection sentinel, its shell hook and its cases: a weaker copy protects nothing
.claude/agents/prompt-injection-auditor.md   @nandovejer
.claude/agents/security-auditor.md           @nandovejer
.claude/hooks/injection-auditor-bash.js      @nandovejer
.claude/settings.json                        @nandovejer
.claude/evals/                               @nandovejer
