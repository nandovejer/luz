{
  "name": "@luz-ds/catalog",
  "version": "0.2.1",
  "description": "LUZ Design System — catalog components, one stylesheet each: the navigation of a site (navbar, sidebar), the light-DOM `<luz-*>` elements (search, cookie consent, time of day, language switch, submenu, announcement, FAQ, timeline), the terminal and the patterns of a landing page, a blog, an app and a documentation site, built on @luz-ds/core",
  "license": "MIT",
  "type": "module",
  "main": "dist/catalog.js",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": "./dist/catalog.js",
    "./search": "./dist/search.js",
    "./cookie-consent": "./dist/cookie-consent.js",
    "./theme-time": "./dist/theme-time.js",
    "./theme-time-bar": "./dist/theme-time-bar.js",
    "./theme-time-boot": "./dist/theme-time-boot.js",
    "./sidebar": "./dist/sidebar.js",
    "./timeline": "./dist/timeline.js",
    "./components/*": "./dist/components/*",
    "./classes.json": "./dist/classes.json",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nandovejer/luz.git",
    "directory": "packages/catalog"
  },
  "homepage": "https://github.com/nandovejer/luz#readme",
  "bugs": {
    "url": "https://github.com/nandovejer/luz/issues"
  },
  "keywords": [
    "design-system",
    "css",
    "catalog",
    "search",
    "cookie-consent",
    "custom-elements",
    "vanilla"
  ],
  "sideEffects": [
    "./dist/components/*.css",
    "./dist/catalog.js",
    "./dist/catalog.min.js",
    "./dist/search.js",
    "./dist/search.min.js",
    "./dist/cookie-consent.js",
    "./dist/cookie-consent.min.js",
    "./dist/theme-time.js",
    "./dist/theme-time.min.js",
    "./dist/theme-time-bar.js",
    "./dist/theme-time-bar.min.js",
    "./dist/timeline.js",
    "./dist/timeline.min.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@luz-ds/core": "^0.1.0 || ^0.2.0 || ^0.3.0",
    "@luz-ds/tokens": "^0.1.0 || ^0.2.0 || ^0.3.0"
  },
  "devDependencies": {
    "@luz-ds/core": "workspace:*",
    "@luz-ds/tokens": "workspace:*"
  }
}
