{
  "name": "@luz-ds/cms",
  "version": "0.1.0",
  "description": "LUZ Design System — the page structure of a blog, a newspaper or any CMS (header, page header, article header, table of contents, footer), built on @luz-ds/core",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./css": "./dist/cms.css",
    "./css/min": "./dist/cms.min.css",
    "./components/*": "./dist/components/*",
    "./classes.json": "./dist/classes.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nandovejer/luz.git",
    "directory": "packages/cms"
  },
  "homepage": "https://github.com/nandovejer/luz#readme",
  "bugs": {
    "url": "https://github.com/nandovejer/luz/issues"
  },
  "keywords": [
    "design-system",
    "css",
    "cms",
    "blog",
    "patterns",
    "vanilla"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@luz-ds/core": "^0.1.0 || ^0.2.0",
    "@luz-ds/catalog": "^0.1.0 || ^0.2.0",
    "@luz-ds/tokens": "^0.1.0 || ^0.2.0"
  },
  "peerDependenciesMeta": {
    "@luz-ds/catalog": {
      "optional": true
    }
  },
  "devDependencies": {
    "@luz-ds/core": "workspace:*",
    "@luz-ds/catalog": "workspace:*",
    "@luz-ds/tokens": "workspace:*"
  }
}
